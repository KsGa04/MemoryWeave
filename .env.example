# Telegram Configuration
TELEGRAM_PHONE_NUMBER=+7XXXXXXXXXX
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Obsidian Configuration
OBSIDIAN_PATH=/path/to/obsidian/vault
OBSIDIAN_API_KEY=your_api_key
OBSIDIAN_API_PORT=27124

# LLM Configuration
LLM_PROVIDER=ollama  # or openai, yandex
LLM_MODEL=llama2
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=sk-...
YANDEX_API_KEY=your_key
YANDEX_API_URL=https://llm.api.cloud.yandex.net/llm/v1/chat

# Vector DB Configuration
VECTOR_DB_PATH=./data/vector_db
EMBEDDING_MODEL=sentence-transformers/multilingual-e5-large

# Server Configuration
PYTHON_SERVER_HOST=127.0.0.1
PYTHON_SERVER_PORT=8000

# Database
DATABASE_URL=sqlite:///./data/memory.db

# Logging
LOG_LEVEL=INFO
